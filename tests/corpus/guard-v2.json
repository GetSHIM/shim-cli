{
  "version": 2,
  "evaluation_unit": "exact redacted output",
  "claim_scope": "Synthetic fixture-bound evidence only; not a real-world statistical claim.",
  "span_rule": "expected_spans are required for every case whose text is not pure ASCII or contains a percent sign, which is exactly the input that bypasses the normalization fast path. Offsets are source coordinates, half-open.",
