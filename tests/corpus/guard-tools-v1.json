{
  "version": 1,
  "evaluation_unit": "exact redacted output at each scanned path",
  "claim_scope": "Synthetic fixture-bound evidence only; not a real-world statistical claim.",
  "capture_provenance": "Real payloads recorded from Claude Code 2.1.250 by scripts/probe/probe.py on 29 Aug 2026; see docs/probe-2026-08.md.",
  "directions": {
    "user-prompt": "The sentence a person typed. Report it; never rewrite it.",
    "outbound": "Structured arguments leaving the machine. Mask in place.",
    "inbound": "A result flowing into the model's context. Mask in place.",
    "local-write": "A payload that lands on the user's disk. Never rewrite.",
    "executable-text": "A free-form command string. Never rewrite; warn, or deny under enforce."
  },
  "output_rule": "expected_output holds the exact post-policy value. Above 2000 input characters it is replaced by expected_output_sha256 of the same value, so one 54 KB capture does not dominate the file. Cases whose direction forbids rewriting carry unchanged=true and an expected_output equal to the input.",
  "cases": [
    {
      "id": "claude-pretooluse-bash-connection-string",
      "client": "claude",
      "event": "PreToolUse",
      "direction": "executable-text",
      "expected_action": "warn",
      "rewritable": false,
      "fixture": "claude/PreToolUse-Bash-bash-connection-string-1.json",
      "scanned": [
        {
          "path": [
            "tool_input",
            "command"
          ],
          "categories": [
            "DB_URI"
          ],
          "input_chars": 65,
          "expected_output": "psql postgresql://alice:s3cr3tpw@db.example.com/app -c 'select 1'",
          "unchanged": true
        }
      ],
      "tool": "Bash"
    },
