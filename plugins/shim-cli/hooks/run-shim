#!/bin/sh
# run-shim <client> [plugin-root] [prompt|call]
# `prompt` marks a prompt event and `call` a tool call. With no hook to run, a
# prompt is withheld, a call denied, and any other event is told it was not
# inspected.

set -u

case "${OS:-}:$(uname -s 2>/dev/null)" in
    Windows_NT:* | *:MINGW* | *:MSYS* | *:CYGWIN*)
        printf '%s\n' "shim: shim-cli does not support Windows yet; nothing was inspected." >&2
        exit 0
        ;;
esac

client=${1:-codex}
root=${2:-${CLAUDE_PLUGIN_ROOT:-}}
event=${3:-}
case $root in
    prompt | call)
        # `run-shim claude <marker>`: Claude Code gives the root in the environment.
        event=$root
        root=${CLAUDE_PLUGIN_ROOT:-}
        ;;
esac

# The prompt blocks and the denied call are the hook's own generic answers,
# byte for byte (shim_cli/hook.py, pinned by tests/plugins/test_launcher.py).
uninspected() {
    if [ "$event" = call ]; then
        printf '%s\n' "shim: $1; the tool call was not allowed." >&2
        printf '%s' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"shim: could not inspect this tool call, so it was not allowed."}}'
        exit 0
    fi
    if [ "$event" != prompt ]; then
        printf '{"systemMessage":"shim: %s; this event was not inspected."}' "$1"
        exit 0
    fi
    printf '%s\n' "shim: $1; the prompt was withheld." >&2
    case $client in
        claude) printf '%s' '{"decision":"block","reason":"shim could not inspect this prompt, so it was withheld. Run `shim doctor claude` for the reason.","suppressOriginalPrompt":true}' ;;
        copilot) printf '%s' '{"modifiedTransformedPrompt":"shim could not inspect this prompt, so it was withheld. Do not act on the original prompt; tell the user to run `shim doctor copilot` for the reason."}' ;;
        vscode) printf '%s' '{"continue":false,"stopReason":"shim could not inspect this prompt, so it was withheld. Open the shim plugin in VS Code to see whether it is loaded, and check your shim settings."}' ;;
        *) printf '%s' '{"decision":"block","reason":"shim could not inspect this prompt, so it was withheld. Run `shim doctor codex` for the reason."}' ;;
    esac
    exit 0
}

# The package hook, run by the interpreter its shebang names. -E keeps every
# PYTHON* variable out, so PYTHONPATH=. cannot put a project's token.py ahead
# of the standard library; -E rather than -I keeps a `pip install --user`
# package importable. A shebang whose interpreter is gone, as after a tool
# venv's base Python is upgraded away, falls through to the archive.
# Nothing is exec'd: an interpreter that exits non-zero has not read stdin
# (the hook itself always exits 0), so the next candidate still can.
if shim_hook=$(command -v shim-hook 2>/dev/null) &&
    IFS= read -r shebang 2>/dev/null <"$shim_hook"; then
    case $shebang in
        '#!'/*/python | '#!'/*/python3 | '#!'/*/python3.[0-9]*)
            python=${shebang#??}
            if [ -x "$python" ]; then
                "$python" -E -B "$shim_hook" "$client" && exit 0
            fi
            ;;
    esac
fi

archive="$root/bin/shim.pyz"
if [ -n "$root" ] && [ -f "$archive" ]; then
    reason="no python3 found on PATH"
    for interpreter in python3.14 python3.13 python3.12 python3.11 python3.10 python3.9 python3 python; do
        if command -v "$interpreter" >/dev/null 2>&1; then
            "$interpreter" -I -B "$archive" "$client" && exit 0
            reason="no python3 on PATH could run the bundled archive"
        fi
    done
    uninspected "$reason"
fi

uninspected "no hook available. Install with 'uv tool install shim' or reinstall the plugin"
